<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>Crops</Name>
            <ViewSelectedBy>
                <TypeName>Crop</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <AutoSize />
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Price</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Growth</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Regrow</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Season</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>